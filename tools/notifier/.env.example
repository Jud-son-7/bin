# Copy to .env in this folder (it is gitignored). Never commit the real values.
# 1. In Telegram, message @BotFather, send /newbot, follow the steps, copy the token.
# 2. Open your new bot and send it any message (e.g. "hi"), or add it to a group.
# 3. Chat id: open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
#    (several ids can be separated by commas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
