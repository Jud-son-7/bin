    sites.forEach(site=>filter.add(new Option(site,site)));
    filter.value=sites.includes(selected)?selected:'';
    const visible=bs.filter(b=>(!filter.value||b.location===filter.value)&&(!$('status-filter').value||status(b)===$('status-filter').value));
    const host=$('site-list'), used=new Set();
    [...new Set(visible.map(b=>b.location))].sort().forEach(site=>{
      const key='site-'+site;
      let section=[...host.children].find(el=>el.dataset.site===key);
      if(!section){section=document.createElement('section');section.dataset.site=key;section.innerHTML='<div class="flex items-baseline gap-3 mb-4"><h3 class="site-title font-bold text-xl"></h3><span class="site-count text-sm text-slate-500"></span></div><div class="site-grid"></div>';host.append(section);}
      text(section.querySelector('.site-title'),site);
      const group=visible.filter(b=>b.location===site);
      text(section.querySelector('.site-count'),`${group.length} ${group.length===1?'bin':'bins'}`);
      const grid=section.querySelector('.site-grid');
      group.forEach(b=>{
        let card=[...host.querySelectorAll('[data-record-id]')].find(el=>el.dataset.recordId===b.__backendId);
        if(!card){card=$('bin-template').content.firstElementChild.cloneNode(true);card.dataset.recordId=b.__backendId;}
        if(card.parentElement!==grid)grid.append(card);
        text(card.querySelector('.bin-code'),b.bin_code);
        text(card.querySelector('.bin-detail'),b.location_detail);
        const s=status(b), badge=card.querySelector('.bin-status');text(badge,statusText[s]);badge.className='bin-status pill '+s;
        text(card.querySelector('.bin-weight'),`${kg(b.current_weight)} of ${kg(b.capacity)}`);
        const pct=Math.round(Number(b.current_weight)/Math.max(Number(b.capacity),.01)*100);
        text(card.querySelector('.bin-percent'),`${pct}% full`);
        card.querySelector('.bar').setAttribute('aria-valuenow',String(Math.min(100,pct)));
        card.querySelector('.bar').setAttribute('aria-label',`${b.bin_code}: ${pct}% of capacity; ${statusText[s]}`);
        card.querySelector('.bin-bar').style.width=Math.min(100,Math.max(0,pct))+'%';
        card.querySelector('.bin-bar').style.background=tone[s];
        text(card.querySelector('.bin-meta'),`Threshold ${kg(b.threshold)} · ${b.assigned_cleaner}`);
        used.add(b.__backendId);
      });
      host.append(section);
    });
    host.querySelectorAll('[data-record-id]').forEach(el=>{if(!used.has(el.dataset.recordId))el.remove();});
    host.querySelectorAll('[data-site]').forEach(el=>{if(![...new Set(visible.map(b=>'site-'+b.location))].includes(el.dataset.site))el.remove();});
    $('empty-view').hidden=!!visible.length;
    renderNotices();
    if(activeId&&!$('detail-overlay').hidden){const current=get(activeId);if(current)renderDetail(current);else closeAll();}
  }
  function renderDetail(b){
    text($('detail-heading'),b.bin_code);
    const d=$('detail-content');
    const lines=[['Status',statusText[status(b)]],['Exact location',`${b.location} · ${b.location_detail}`],['Assigned cleaner',b.assigned_cleaner],['Current weight',kg(b.current_weight)],['Alert threshold',kg(b.threshold)],['Capacity',kg(b.capacity)],['Last reading',b.last_reading_at?new Date(b.last_reading_at).toLocaleString('en-AU'):'Not recorded']];
    lines.forEach(([label,value],i)=>{let p=d.children[i];if(!p){p=document.createElement('p');p.className='border-b border-slate-200 pb-2 text-sm';d.append(p);}text(p,`${label}: ${value}`);});
    while(d.children.length>lines.length)d.lastElementChild.remove();
    if(document.activeElement!==$('new-reading'))$('new-reading').value=b.current_weight;
  }
  function renderNotices(){
    const host=$('notification-list'), all=notices().sort((a,b)=>b.created_at.localeCompare(a.created_at)), ids=new Set(all.map(n=>n.__backendId));
    all.forEach(n=>{
      let row=[...host.children].find(el=>el.dataset.id===n.__backendId);
      if(!row){row=$('notification-template').content.firstElementChild.cloneNode(true);row.dataset.id=n.__backendId;}
      text(row.querySelector('.notification-title'),`${n.notification_cleaner} · ${n.notification_bin_code}`);
      text(row.querySelector('.notification-message'),n.notification_message);
      text(row.querySelector('.notification-date'),n.created_at?new Date(n.created_at).toLocaleString('en-AU'):'');
      const badge=row.querySelector('.notification-state');
      text(badge,n.notification_handled?'Handled':n.notification_read?'Read':'Unread');
      badge.className='notification-state pill '+(n.notification_handled?'normal':n.notification_read?'approaching':'ready');
      row.querySelector('[data-template-id="mark-read-button"]').hidden=n.notification_read||n.notification_handled;
      row.querySelector('[data-template-id="mark-handled-button"]').hidden=n.notification_handled;
      host.append(row);
    });
    [...host.children].forEach(row=>{if(!ids.has(row.dataset.id))row.remove();});
    $('no-notifications').hidden=!!all.length;
  }
  const handler={onDataChanged(data){clearTimeout(loadTimer);backendRecords=data;ready=true;$('retry-button').classList.add('hidden');feedback('');render();}};
  async function initialize(){
    ready=false;feedback('Loading saved bins…');$('retry-button').classList.add('hidden');
    clearTimeout(loadTimer);
    loadTimer=setTimeout(()=>loadError('Could not load saved bins.'),8000);
    try{const result=await window.dataSdk.init(handler);if(!result.isOk){clearTimeout(loadTimer);loadError('Could not connect to your Canva Sheet.');}}
    catch(e){clearTimeout(loadTimer);loadError('Could not connect to your Canva Sheet.');}
  }
  function loadError(message){feedback(`${message} Select Retry to try again.`,true);$('retry-button').classList.remove('hidden');}
  async function createNotice(b) {
    const now=new Date().toISOString();
    const notice={...blank(),record_type:'notification',bin_code:b.bin_code,notification_bin_code:b.bin_code,notification_weight:Number(b.current_weight),notification_cleaner:b.assigned_cleaner,notification_message:`${b.assigned_cleaner}: take out the garbage from bin ${b.bin_code} at ${b.location}, ${b.location_detail}. Current weight: ${kg(b.current_weight)}; alert threshold: ${kg(b.threshold)}.`,created_at:now};
    if(backendRecords.length>=999){feedback('The Canva Sheet has reached its 999-record limit; the cleaner alert could not be saved.',true);return false;}
    const result=await window.dataSdk.create(notice);
    if(!result.isOk){feedback('The bin change was saved, but the cleaner alert could not be confirmed. Refresh before trying again.',true);return false;}
    return true;
  }
  document.querySelectorAll('.close-dialog').forEach(b=>b.addEventListener('click',closeAll));
  document.querySelectorAll('.overlay').forEach(el=>el.addEventListener('click',e=>{if(e.target===el)closeAll();}));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll();});
  $('retry-button').addEventListener('click',initialize);
  $('location-filter').addEventListener('change',render);$('status-filter').addEventListener('change',render);
  $('add-open').addEventListener('click',()=>{editingId=null;$('bin-form').reset();open('form-overlay');$('bin-code').focus();});
  $('notifications-open').addEventListener('click',()=>open('notifications-overlay'));
  $('site-list').addEventListener('click',e=>{const button=e.target.closest('[data-template-id="view-bin-button"]');if(!button)return;activeId=button.closest('[data-record-id]').dataset.recordId;const b=get(activeId);if(b){renderDetail(b);open('detail-overlay');}});
  $('edit-bin').addEventListener('click',()=>{
    const b=get(activeId);if(!b)return;
    editingId=activeId;
    [['bin-code',b.bin_code],['site',b.location],['exact-location',b.location_detail],['cleaner',b.assigned_cleaner],['weight',b.current_weight],['threshold',b.threshold],['capacity',b.capacity]].forEach(([id,value])=>$(id).value=value);
    closeAll();open('form-overlay');
  });
  $('bin-form').addEventListener('submit',async e=>{
    e.preventDefault();const button=e.submitter||$('save-bin');
    const entry={bin_code:$('bin-code').value.trim(),location:$('site').value.trim(),location_detail:$('exact-location').value.trim(),assigned_cleaner:$('cleaner').value.trim(),current_weight:Number($('weight').value),threshold:Number($('threshold').value),capacity:Number($('capacity').value)};
    if(!entry.bin_code||!entry.location||!entry.location_detail||!entry.assigned_cleaner||entry.threshold<=0||entry.capacity<=0||entry.threshold>entry.capacity||entry.current_weight<0){feedback('Complete every field. Threshold must be above zero and no greater than capacity.',true);return;}
    if(bins().some(b=>b.bin_code.toLowerCase()===entry.bin_code.toLowerCase()&&b.__backendId!==editingId)){feedback('That bin ID already exists. Choose a unique ID.',true);return;}
    if(!editingId&&backendRecords.length>=999){feedback('The Canva Sheet has reached its 999-record limit.',true);return;}
    const old=editingId?get(editingId):null;if(editingId&&!old){feedback('This bin is no longer available.',true);return;}
    const now=new Date().toISOString(), record=old?{...old,...entry,last_reading_at:now}:{...blank(),...entry,record_type:'bin',created_at:now,last_reading_at:now};
    pending(button,true);
    try{
      const result=await(old?window.dataSdk.update(record):window.dataSdk.create(record));
      if(!result.isOk){fail();return;}
      closeAll();feedback('Bin saved.');
      if(entry.current_weight>entry.threshold&&(!old||Number(old.current_weight)<=Number(old.threshold)))if(await createNotice(record))feedback('Bin saved. Cleaner notification created.');
    }catch(err){fail();}finally{pending(button,false);}
  });
  $('reading-form').addEventListener('submit',async e=>{
    e.preventDefault();const b=get(activeId),button=e.submitter;
    if(!b)return;const weight=Number($('new-reading').value);if(!Number.isFinite(weight)||weight<0){feedback('Enter a valid non-negative weight.',true);return;}
    const updated={...b,current_weight:weight,last_reading_at:new Date().toISOString()};
    pending(button,true);
    try{
      const result=await window.dataSdk.update(updated);
      if(!result.isOk){fail();return;}
      feedback('Reading saved.');
      if(weight>Number(b.threshold)&&Number(b.current_weight)<=Number(b.threshold))if(await createNotice(updated))feedback('Reading saved. Cleaner notification created.');
    }catch(err){fail();}finally{pending(button,false);}
  });
  $('delete-bin').addEventListener('click',()=>{ $('delete-bin').hidden=true;$('confirm-delete').classList.remove('hidden');$('cancel-delete').classList.remove('hidden');});
  $('cancel-delete').addEventListener('click',()=>{ $('delete-bin').hidden=false;$('confirm-delete').classList.add('hidden');$('cancel-delete').classList.add('hidden');});
  $('confirm-delete').addEventListener('click',async e=>{
    const b=get(activeId),button=e.currentTarget;if(!b)return;pending(button,true);
    try{const result=await window.dataSdk.delete(b);if(!result.isOk){fail();return;}closeAll();feedback('Bin removed. Existing notification history remains available.');}
    catch(err){fail();}finally{pending(button,false);$('delete-bin').hidden=false;button.classList.add('hidden');$('cancel-delete').classList.add('hidden');}
  });
  $('notification-list').addEventListener('click',async e=>{
    const button=e.target.closest('button');if(!button)return;
    const n=get(button.closest('[data-id]').dataset.id);if(!n)return;
    const handled=button.matches('[data-template-id="mark-handled-button"]');
    pending(button,true);
    try{
      const result=await window.dataSdk.update({...n,notification_read:true,notification_handled:handled?true:n.notification_handled});
      if(!result.isOk){fail();return;}feedback(handled?'Notification marked handled.':'Notification marked read.');
    }catch(err){fail();}finally{pending(button,false);}
  });
  initialize();
})();
</script>
 
</body></html>
